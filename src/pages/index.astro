---
import LatexIntro from '../components/LatexIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { roleLine, site } from '../data/site';

const sections = [
  { href: '/research/', title: 'Research', desc: 'Theses, papers and research projects.' },
  { href: '/projects/', title: 'Projects', desc: 'Things I have built, mostly for the fun of it.' },
  {
    href: '/experience/',
    title: 'Experience & education',
    desc: 'Where I have worked and studied.',
  },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', site.url).href,
  description: site.description,
  jobTitle: site.role.title,
  worksFor: { '@type': 'GovernmentOrganization', name: site.role.org },
  workLocation: { '@type': 'Place', name: site.role.location },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Monash University' },
  knowsAbout: [
    'Machine learning',
    'Agentic AI',
    'Multi-agent reinforcement learning',
    'Software engineering',
  ],
  sameAs: [site.github, site.linkedin],
};
---

<BaseLayout
  spacious
  preloadMono
  ogImage="home"
  ogImageAlt={`${site.name}: ${roleLine}`}
  jsonLd={person}
>
  <section class="hero" aria-labelledby="home-title">
    <h1 id="home-title" class="home-title">
      <span class="home-title-text" transition:name="site-name">
        {site.name}
      </span>
    </h1>
    <LatexIntro />
    <p class="role-line">{roleLine}</p>
    <p class="about">{site.about}</p>
  </section>

  <nav class="section-index" aria-label="Sections">
    <ul>
      {sections.map((section) => (
        <li>
          <a href={section.href} class="section-row">
            <span class="section-title">{section.title}</span>
            <span class="section-desc">
              <span>{section.desc}</span>
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
  }

  .home-title {
    margin-bottom: 28px;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(44px, 11vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .home-title-text {
    display: inline-block;
  }

  .role-line {
    margin-top: 8px;
    font-size: 14px;
    color: var(--muted);
  }

  .about {
    margin-top: 48px;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 20px;
    line-height: 1.6;
    color: var(--body);
  }

  .section-index ul {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--text);
  }

  .section-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 32px;
    padding: 30px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .section-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(30px, 7vw, 40px);
    line-height: 1.1;
  }

  .section-desc {
    flex: 1 1 280px;
    max-width: 420px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--body);
  }

  @media (max-width: 640px) {
    .about {
      margin-top: 40px;
      font-size: 18px;
    }

    .section-row {
      padding: 24px 0;
    }
  }
</style>
