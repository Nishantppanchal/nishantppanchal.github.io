---
import { site } from '../data/site';

const { user, domain, tld } = site.email;

// Base64 of the reversed address: no "@" or "mailto:" for scrapers to match.
// src/scripts/site.ts decodes it into a link.
const encoded = btoa([...`${user}@${domain}.${tld}`].reverse().join(''));
---

<footer class="site-footer">
  <p class="email" data-email={encoded}>
    {user}[at]{domain}[dot]{tld}
  </p>
  <ul class="social">
    <li>
      <a href={site.github} rel="me">
        GitHub
      </a>
    </li>
    <li>
      <a href={site.linkedin} rel="me">
        LinkedIn
      </a>
    </li>
  </ul>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0 16px;
    font-size: 14px;
    color: var(--muted);
  }

  .email {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }

  .social {
    display: flex;
    gap: 24px;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
</style>
