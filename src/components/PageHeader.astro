---
export interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="page-header" aria-labelledby="page-title">
  <h1 id="page-title" class="page-title">
    {title}
  </h1>
  <p class="page-subtitle">{subtitle}</p>
</section>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
</style>
